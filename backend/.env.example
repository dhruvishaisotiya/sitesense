# SiteSense — backend environment variables
#
# Copy this file to `.env` and adjust. `.env` is gitignored and must never be
# committed. Every variable here has a development-safe default, so local
# development works without setting any of them.
#
# Load them into your shell with:  set -a; source .env; set +a

# ---- Core ----

# Development: leave True. Production: set to False.
# With DEBUG=False the app refuses to start unless DJANGO_SECRET_KEY is set,
# and it enables HSTS, secure cookies and SSL redirect.
DJANGO_DEBUG=True

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this app will serve.
# Development default: localhost,127.0.0.1,[::1]
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ---- CORS ----

# Comma-separated frontend origins allowed to call the API.
# Ignored while DEBUG=True (all origins are allowed in development).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Logging ----

# DEBUG | INFO | WARNING | ERROR
# Set to DEBUG to see the AI engine's feature and prediction dumps.
# Defaults to INFO when DEBUG=True, WARNING otherwise.
SITESENSE_LOG_LEVEL=INFO

# ---- Optional: production hardening ----

# Redirect all HTTP traffic to HTTPS. Only applies when DEBUG=False.
# Set to False if your host already terminates TLS and redirects for you.
DJANGO_SECURE_SSL_REDIRECT=True
